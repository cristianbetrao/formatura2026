    <!-- LÓGICA DO SISTEMA -->
    <script>
        // Configuração das parcelas
        const VALOR_PARCELA = 40;
        const QTD_PARCELAS = 10;
        const VALOR_TOTAL_FORMANDO = VALOR_PARCELA * QTD_PARCELAS; // R$ 400
        const MES_INICIO = 3; // Março = P1

        // Função para ordenar os formandos em ordem alfabética crescente (A-Z)
        function ordenarFormandos() {
            if (estado && estado.estudantes) {
                estado.estudantes.sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR', { sensitivity: 'base' }));
            }
        }

        // Função para calcular dinamicamente o mês atual real do computador
        function obterMesAtualAutomatico() {
            const mesAtualReal = new Date().getMonth() + 1;
            if (mesAtualReal < 3) return 3;  // Se estiver em Jan/Fev, ajusta para o início do plano (Março)
            if (mesAtualReal > 12) return 12; // Se passar de Dezembro, fixa em Dezembro
            return mesAtualReal;
        }

        // Função para remover caracteres especiais mantendo apenas letras, números e espaços (usada em outros campos)
        function limparCaracteresEspeciais(str) {
            return str ? str.replace(/[^a-zA-Z0-9\s]/g, '') : '';
        }

        // Estado da Aplicação
        let estado = {
            cabecalho: {
                turma: 'Formatura AFV 2026',
                lider: '',
                contatoLider: '',
                mesVigente: obterMesAtualAutomatico(),
                painelRecolhido: false
            },
            estudantes: []
        };

        let parcelaEmEdicao = {
            estudanteId: null,
            numParcela: null
        };

        // Trata o input de contato em tempo real sem caracteres especiais
        function tratarEGuardarContatoLider(input) {
            input.value = limparCaracteresEspeciais(input.value);
            salvarCabecalho();
        }

        // Alternar visualização do painel recolhível
        function togglePainelInfo() {
            const conteudo = document.getElementById('conteudoPainelInfo');
            const seta = document.getElementById('setaToggleInfo');
            const label = document.getElementById('labelToggleInfo');

            estado.cabecalho.painelRecolhido = !estado.cabecalho.painelRecolhido;

            if (estado.cabecalho.painelRecolhido) {
                conteudo.classList.add('hidden');
                seta.classList.add('rotate-180');
                label.innerText = 'Mostrar Painel';
            } else {
                conteudo.classList.remove('hidden');
                seta.classList.remove('rotate-180');
                label.innerText = 'Ocultar Painel';
            }
            salvarLocalStorage();
        }

        // Alternar detalhes recolhidos do formando ao clicar no nome
        function toggleDetalhesEstudante(id) {
            const linhaDetalhes = document.getElementById(`detalhes_${id}`);
            const seta = document.getElementById(`seta_${id}`);
            if (linhaDetalhes) {
                linhaDetalhes.classList.toggle('hidden');
            }
            if (seta) {
                seta.classList.toggle('rotate-180');
            }
        }

        // Alternar status ativo/inativo do formando
        function toggleStatusAtivoEstudante(id) {
            const est = estado.estudantes.find(e => e.id === id);
            if (!est) return;

            est.ativo = !(est.ativo !== false);
            salvarLocalStorage();
            renderizar();
            mostrarToast(est.ativo ? `${est.nome} foi ativado(a)!` : `${est.nome} foi inativado(a)!`);
        }

        // Toggle do Menu de Ações
        function toggleMenuAcoes() {
            const dropdown = document.getElementById('dropdownAcoes');
            const seta = document.getElementById('setaMenuAcoes');
            dropdown.classList.toggle('hidden');
            if (seta) seta.classList.toggle('rotate-180');
        }

        function fecharMenuAcoes() {
            const dropdown = document.getElementById('dropdownAcoes');
            const seta = document.getElementById('setaMenuAcoes');
            if (dropdown) dropdown.classList.add('hidden');
            if (seta) seta.classList.remove('rotate-180');
        }

        // Fechar dropdown ao clicar fora
        window.addEventListener('click', function(e) {
            const btn = document.getElementById('btnMenuAcoes');
            const dropdown = document.getElementById('dropdownAcoes');
            if (btn && dropdown && !btn.contains(e.target) && !dropdown.contains(e.target)) {
                fecharMenuAcoes();
            }
        });

        // Inicialização
        window.addEventListener('DOMContentLoaded', () => {
            renderizarCabecalhoTabela();
            carregarDadosSalvos();
            document.getElementById('selectMesVigente').value = estado.cabecalho.mesVigente;
            verificarUsoLocalStorage();
            renderizar();
        });

        function alterarMesVigente(val) {
            estado.cabecalho.mesVigente = parseInt(val) || obterMesAtualAutomatico();
            salvarLocalStorage();
            renderizar();
            mostrarToast('Mês de referência atualizado!');
        }

        // Calcula status do formando (Incluindo o status "Quitado")
        function calcularStatusEstudante(estudante) {
            if (estudante.ativo === false) {
                return { texto: 'Inativo', cor: 'bg-slate-200 text-slate-600 border-slate-300', icone: 'fa-user-slash' };
            }

            const mesAtual = estado.cabecalho.mesVigente || obterMesAtualAutomatico();
            
            let parcelasEsperadas = 0;
            if (mesAtual >= MES_INICIO && mesAtual <= 12) {
                parcelasEsperadas = (mesAtual - MES_INICIO) + 1;
            } else if (mesAtual > 12) {
                parcelasEsperadas = 10;
            }

            let ultimaPaga = 0;
            let totalPago = 0;

            for (let p = 1; p <= QTD_PARCELAS; p++) {
                const dadosP = estudante.parcelas[p] || { valor: 0 };
                const v = parseFloat(dadosP.valor) || 0;
                totalPago += v;
                if (v >= VALOR_PARCELA) {
                    ultimaPaga = p;
                }
            }

            const parcelasCobertasPeloTotal = Math.floor(totalPago / VALOR_PARCELA);
            const nivelPagamento = Math.max(ultimaPaga, parcelasCobertasPeloTotal);

            // Verifica se pagou todas as parcelas (Quitado)
            if (totalPago >= VALOR_TOTAL_FORMANDO || parcelasCobertasPeloTotal >= QTD_PARCELAS) {
                return { texto: 'Quitado', cor: 'bg-emerald-600 text-white border-emerald-700 shadow-sm', icone: 'fa-certificate' };
            }

            if (nivelPagamento < parcelasEsperadas) {
                return { texto: 'Atrasado(a)', cor: 'bg-rose-100 text-rose-800 border-rose-300', icone: 'fa-circle-exclamation' };
            } else if (nivelPagamento === parcelasEsperadas) {
                return { texto: 'Em dia', cor: 'bg-emerald-100 text-emerald-800 border-emerald-300', icone: 'fa-circle-check' };
            } else {
                return { texto: 'Adiantado(a)', cor: 'bg-purple-100 text-purple-800 border-purple-300', icone: 'fa-forward' };
            }
        }

        function renderizarCabecalhoTabela() {
            const template = document.getElementById('thParcelasTemplate');
            let html = '';
            const nomesMeses = ['Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
            for (let i = 1; i <= QTD_PARCELAS; i++) {
                html += `
                    <th class="p-2 text-center min-w-[85px]">
                        <span class="block font-bold">P${i} (${nomesMeses[i-1]})</span>
                        <span class="text-[9px] text-slate-400 font-normal">R$40</span>
                    </th>
                `;
            }
            template.outerHTML = html;
        }

        function renderizar() {
            ordenarFormandos();
            const tbody = document.getElementById('tabelaCorpo');
            const estadoVazio = document.getElementById('estadoVazio');
            const busca = document.getElementById('inputBusca').value.toLowerCase();

            tbody.innerHTML = '';

            const estudantesFiltrados = estado.estudantes.filter(est => 
                est.nome.toLowerCase().includes(busca)
            );

            if (estudantesFiltrados.length === 0) {
                estadoVazio.classList.remove('hidden');
            } else {
                estadoVazio.classList.add('hidden');
            }

            let somaP = Array(QTD_PARCELAS).fill(0);
            let totalGeralArrecadado = 0;
            let totalPix = 0;
            let totalEspecie = 0;
            let qtdPix = 0;
            let qtdEspecie = 0;

            estudantesFiltrados.forEach((est, index) => {
                const eAtivo = est.ativo !== false;
                const tr = document.createElement('tr');
                tr.className = `hover:bg-slate-50/80 transition text-slate-700 ${!eAtivo ? 'opacity-50 grayscale bg-slate-50' : ''}`;

                let totalPagoEstudante = 0;
                let parcelasHTML = '';

                for (let p = 1; p <= QTD_PARCELAS; p++) {
                    const dadosP = est.parcelas[p] || { valor: 0, meio: 'Pendente' };
                    const valorNum = parseFloat(dadosP.valor) || 0;
                    
                    totalPagoEstudante += valorNum;
                    somaP[p - 1] += valorNum;

                    if (valorNum > 0) {
                        if (dadosP.meio === 'PIX') {
                            totalPix += valorNum;
                            qtdPix++;
                        } else if (dadosP.meio === 'Espécie') {
                            totalEspecie += valorNum;
                            qtdEspecie++;
                        } else if (dadosP.meio === 'Ambos') {
                            totalPix += valorNum / 2;
                            totalEspecie += valorNum / 2;
                            qtdPix++;
                            qtdEspecie++;
                        }
                    }

                    let badgeColor = 'bg-slate-100 text-slate-500 border-slate-200';
                    let valorClass = 'text-slate-400';

                    if (valorNum >= 40) {
                        badgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                        valorClass = 'text-emerald-700 font-bold';
                    } else if (valorNum > 0) {
                        badgeColor = 'bg-amber-50 text-amber-700 border-amber-200';
                        valorClass = 'text-amber-700 font-semibold';
                    }

                    let meioBadge = '';
                    if (valorNum > 0) {
                        if (dadosP.meio === 'PIX') meioBadge = `<span class="text-[9px] bg-indigo-100 text-indigo-700 px-1 rounded">PIX</span>`;
                        else if (dadosP.meio === 'Espécie') meioBadge = `<span class="text-[9px] bg-teal-100 text-teal-700 px-1 rounded">ESP</span>`;
                        else if (dadosP.meio === 'Ambos') meioBadge = `<span class="text-[9px] bg-purple-100 text-purple-700 px-1 rounded">AMB</span>`;
                    }

                    parcelasHTML += `
                        <td class="p-1.5 text-center cursor-pointer hover:bg-indigo-50/50 transition border-r border-slate-100" onclick="abrirModalParcela('${est.id}', ${p})">
                            <div class="flex flex-col items-center justify-center min-h-[38px] p-1 rounded border ${badgeColor}">
                                <span class="${valorClass}">R$ ${valorNum.toFixed(0)}</span>
                                ${meioBadge}
                            </div>
                        </td>
                    `;
                }

                totalGeralArrecadado += totalPagoEstudante;

                const stInfo = calcularStatusEstudante(est);
                const statusBadge = `
                    <span class="inline-flex items-center gap-1 ${stInfo.cor} border text-[10px] font-extrabold px-2.5 py-1 rounded-full uppercase shadow-xs">
                        <i class="fa-solid ${stInfo.icone}"></i> ${stInfo.texto}
                    </span>
                `;

                const botaoStatusAtivo = eAtivo 
                    ? `<button onclick="toggleStatusAtivoEstudante('${est.id}')" title="Inativar Formando (ocultar no PDF)" class="p-1.5 bg-amber-100 hover:bg-amber-200 text-amber-800 rounded transition text-xs"><i class="fa-solid fa-eye-slash"></i></button>`
                    : `<button onclick="toggleStatusAtivoEstudante('${est.id}')" title="Ativar Formando (exibir no PDF)" class="p-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded transition text-xs"><i class="fa-solid fa-eye"></i></button>`;

                tr.innerHTML = `
                    <td class="p-3 text-center text-slate-400 font-medium w-12 min-w-[48px] max-w-[48px] sticky left-0 bg-white z-20 shadow-sm border-r border-slate-200">${index + 1}</td>
                    <td class="p-3 font-semibold text-slate-800 sticky left-[48px] bg-white z-20 shadow-md border-r border-slate-300 cursor-pointer select-none hover:bg-indigo-50/50 transition" onclick="toggleDetalhesEstudante('${est.id}')">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-indigo-950 font-bold hover:text-indigo-600 transition flex items-center gap-1.5">
                                ${est.nome}
                                ${!eAtivo ? '<span class="text-[9px] bg-slate-200 text-slate-600 px-1.5 py-0.5 rounded font-normal">(Inativo)</span>' : ''}
                            </span>
                            <i class="fa-solid fa-chevron-down text-[10px] text-indigo-400 transition-transform" id="seta_${est.id}"></i>
                        </div>
                    </td>
                    ${parcelasHTML}
                    <td class="p-3 text-center font-bold text-slate-900 bg-slate-50 border-r">
                        R$ ${totalPagoEstudante.toFixed(2)}
                    </td>
                    <td class="p-3 text-center whitespace-nowrap">
                        ${statusBadge}
                    </td>
                    <td class="p-3 text-center no-print">
                        <div class="flex justify-center items-center space-x-1">
                            ${botaoStatusAtivo}
                            <button onclick="quitarTotalmente('${est.id}')" title="Quitar todas as 10 parcelas" class="p-1.5 bg-emerald-100 hover:bg-emerald-200 text-emerald-700 rounded transition text-xs">
                                <i class="fa-solid fa-check-double"></i>
                            </button>
                            <button onclick="editarEstudante('${est.id}')" title="Editar Estudante" class="p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded transition text-xs">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button onclick="removerEstudante('${est.id}')" title="Excluir Estudante" class="p-1.5 bg-rose-100 hover:bg-rose-200 text-rose-700 rounded transition text-xs">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;

                tbody.appendChild(tr);

                // Linha de Detalhes Recolhida (Expandível ao clicar no nome)
                const trDetalhes = document.createElement('tr');
                trDetalhes.id = `detalhes_${est.id}`;
                trDetalhes.className = `hidden bg-indigo-50/40 border-b border-indigo-100 transition-all ${!eAtivo ? 'opacity-50 grayscale' : ''}`;

                const telExibicao = est.telefone ? est.telefone : 'Não informado';
                const obsExibicao = est.obs ? est.obs : 'Nenhuma observação registrada.';

                trDetalhes.innerHTML = `
                    <td colspan="15" class="p-3">
                        <div class="flex flex-wrap items-center gap-6 text-xs text-slate-700 pl-4 border-l-4 border-indigo-500 my-1">
                            <div class="flex items-center gap-2">
                                <i class="fa-brands fa-whatsapp text-emerald-600 text-base"></i>
                                <span><strong class="font-bold text-slate-800">Telefone:</strong> ${telExibicao}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-note-sticky text-amber-500 text-base"></i>
                                <span><strong class="font-bold text-slate-800">Observação:</strong> ${obsExibicao}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-user text-indigo-500 text-base"></i>
                                <span><strong class="font-bold text-slate-800">Situação:</strong> ${eAtivo ? 'Ativo na Turma' : 'Inativado (Oculto no PDF)'}</span>
                            </div>
