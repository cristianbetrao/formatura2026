<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão Financeira - Formatura AFV 2026</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- html2pdf.js for PDF Generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    
    <style>
        /* Custom scrollbars for large table */
        .table-container::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        .table-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        .table-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .table-container::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
        }
        /* Printable Report Minimalist Formatting */
        .pdf-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10px;
        }
        .pdf-table th {
            background-color: #f1f5f9;
            color: #1e293b;
            font-weight: 700;
            text-transform: uppercase;
            padding: 6px 8px;
            border-bottom: 2px solid #cbd5e1;
        }
        .pdf-table td {
            padding: 5px 8px;
            border-bottom: 1px solid #e2e8f0;
            color: #334155;
        }
        .pdf-table tr:nth-child(even) {
            background-color: #f8fafc;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Header Principal -->
    <header class="bg-indigo-900 text-white shadow-md no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <!-- Ícone / Logo de Chapéu de Formatura -->
                <div class="bg-indigo-800/80 p-2.5 rounded-xl shadow-inner flex items-center justify-center border border-indigo-700/50">
                    <i class="fa-solid fa-graduation-cap text-3xl text-indigo-200"></i>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold tracking-tight flex items-center gap-2">
                        Formatura AFV 2026
                        <span class="text-[10px] bg-indigo-700 text-indigo-100 font-semibold px-2 py-0.5 rounded-full uppercase">Fluxo de Caixa</span>
                    </h1>
                    <p class="text-xs text-indigo-200">Gestão de Parcelas (Março a Dezembro • 10x R$40)</p>
                </div>
            </div>
            
            <!-- Menu de Ações Recolhível Organizado -->
            <div class="relative inline-block text-left">
                <button id="btnMenuAcoes" onclick="toggleMenuAcoes()" class="bg-indigo-800 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center shadow-md transition border border-indigo-700">
                    <i class="fa-solid fa-bars-staggered mr-2 text-indigo-300"></i>
                    <span>Menu de Opções</span>
                    <i class="fa-solid fa-chevron-down ml-2 text-xs text-indigo-300 transition-transform" id="setaMenuAcoes"></i>
                </button>

                <!-- Dropdown de Opções Reorganizado -->
                <div id="dropdownAcoes" class="hidden absolute right-0 mt-2 w-72 bg-white rounded-xl shadow-2xl py-2 z-50 text-slate-800 border border-slate-200 divide-y divide-slate-100 transform transition-all">
                    <!-- Bloco 1: Ações Principais / Salvamento -->
                    <div class="py-1">
                        <button onclick="salvarDadosComAlerta(); fecharMenuAcoes();" class="w-full text-left px-4 py-2.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-50 flex items-center">
                            <i class="fa-solid fa-floppy-disk w-6 text-emerald-600 text-sm"></i> Salvar Alterações
                        </button>
                    </div>
                    <!-- Bloco 2: Importação e Backup -->
                    <div class="py-1">
                        <div class="px-4 py-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Backups e Arquivos</div>
                        <button onclick="exportarJSON(); fecharMenuAcoes();" class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 flex items-center">
                            <i class="fa-solid fa-download w-6 text-indigo-600 text-sm"></i> Exportar Backup (.JSON)
                        </button>
                        <label class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 flex items-center cursor-pointer">
                            <i class="fa-solid fa-file-code w-6 text-indigo-600 text-sm"></i> Importar Backup (.JSON)
                            <input type="file" id="importJsonFileInput" accept=".json" class="hidden" onchange="importarArquivoJSON(event); fecharMenuAcoes();">
                        </label>
                        <button onclick="baixarModeloCSV(); fecharMenuAcoes();" class="w-full text-left px-4 py-2 text-xs font-semibold text-amber-700 hover:bg-amber-50 flex items-center">
                            <i class="fa-solid fa-file-arrow-down w-6 text-amber-600 text-sm"></i> Baixar Modelo (.CSV)
                        </button>
                        <label class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 flex items-center cursor-pointer">
                            <i class="fa-solid fa-file-csv w-6 text-teal-600 text-sm"></i> Importar Planilha (.CSV)
                            <input type="file" id="importCsvFileInput" accept=".csv" class="hidden" onchange="importarArquivoCSV(event); fecharMenuAcoes();">
                        </label>
                    </div>
                    <!-- Bloco 3: Relatórios e Exportação Externa -->
                    <div class="py-1">
                        <div class="px-4 py-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Relatórios</div>
                        <button onclick="exportarCSV(); fecharMenuAcoes();" class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 flex items-center">
                            <i class="fa-solid fa-file-excel w-6 text-teal-600 text-sm"></i> Exportar para Excel (.CSV)
                        </button>
                        <button onclick="gerarPDF(); fecharMenuAcoes();" class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 flex items-center">
                            <i class="fa-solid fa-file-pdf w-6 text-rose-600 text-sm"></i> Baixar Relatório PDF (Retrato)
                        </button>
                    </div>
                    <!-- Bloco 4: Zona de Perigo / Manutenção -->
                    <div class="py-1">
                        <button onclick="confirmarLimpezaLocalStorage(); fecharMenuAcoes();" class="w-full text-left px-4 py-2.5 text-xs font-semibold text-rose-700 hover:bg-rose-50 flex items-center">
                            <i class="fa-solid fa-trash-can w-6 text-rose-600 text-sm"></i> Limpar Dados do Navegador
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Conteúdo Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Banner de Alerta do LocalStorage -->
        <div id="bannerAlertaStorage" class="hidden bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl shadow-sm no-print">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <i class="fa-solid fa-triangle-exclamation text-amber-600 text-xl mr-3"></i>
                    <div>
                        <h4 class="text-xs font-extrabold uppercase text-amber-800">Aviso do Armazenamento Local</h4>
                        <p class="text-xs text-amber-700 mt-0.5" id="textoAlertaStorage">Seu navegador está acumulando muitos dados. Recomendamos exportar um backup .JSON e limpar o cache do sistema.</p>
                    </div>
                </div>
                <button onclick="exportarJSON()" class="bg-amber-600 hover:bg-amber-700 text-white font-bold px-3 py-1.5 rounded-lg text-xs transition shadow-xs">
                    Fazer Backup Agora
                </button>
            </div>
        </div>

        <!-- Informações do Líder e Turma (Recolhível) -->
        <section class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden no-print">
            <div class="bg-slate-100/70 px-5 py-3 flex justify-between items-center border-b border-slate-200 cursor-pointer select-none" onclick="togglePainelInfo()">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-id-card text-indigo-700 text-sm"></i>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Informações da Turma e Comissão</h2>
                </div>
                <button id="btnToggleInfo" class="text-slate-500 hover:text-slate-700 text-xs font-semibold flex items-center gap-1 transition">
                    <span id="labelToggleInfo">Ocultar Painel</span>
                    <i class="fa-solid fa-chevron-up text-xs transition-transform" id="setaToggleInfo"></i>
                </button>
            </div>

            <div id="conteudoPainelInfo" class="p-5 transition-all">
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Nome da Turma / Curso</label>
                        <input type="text" id="infoTurma" placeholder="Ex: 3º Ano Matutino - AFV" oninput="salvarCabecalho()" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-semibold text-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Nome do Líder Responsável</label>
                        <input type="text" id="infoLider" placeholder="Ex: João Silva" oninput="salvarCabecalho()" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-semibold text-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Contato do Líder de Turma</label>
                        <input type="text" id="infoContatoLider" placeholder="Ex: 79 999999999" oninput="tratarEGuardarContatoLider(this)" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-semibold text-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-indigo-700 mb-1">
                            <i class="fa-solid fa-calendar-day mr-1"></i> Mês de Referência
                        </label>
                        <select id="selectMesVigente" onchange="alterarMesVigente(this.value)" class="w-full px-3 py-2 border border-indigo-200 bg-indigo-50/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-bold text-indigo-900">
                            <option value="3">Março (Parcela 1)</option>
                            <option value="4">Abril (Parcela 2)</option>
                            <option value="5">Maio (Parcela 3)</option>
                            <option value="6">Junho (Parcela 4)</option>
                            <option value="7">Julho (Parcela 5)</option>
                            <option value="8">Agosto (Parcela 6)</option>
                            <option value="9">Setembro (Parcela 7)</option>
                            <option value="10">Outubro (Parcela 8)</option>
                            <option value="11">Novembro (Parcela 9)</option>
                            <option value="12">Dezembro (Parcela 10)</option>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cards de Resumo Financeiro -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Arrecadado Turma</p>
                    <h3 class="text-2xl font-extrabold text-emerald-600 mt-1" id="statArrecadado">R$ 0,00</h3>
                    <p class="text-xs text-slate-400 mt-0.5" id="statMetaMeta">Meta: R$ 0,00</p>
                </div>
                <div class="p-3 bg-emerald-50 rounded-lg text-emerald-600">
                    <i class="fa-solid fa-wallet text-2xl"></i>
                </div>
            </div>

            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Pendente Turma</p>
                    <h3 class="text-2xl font-extrabold text-amber-600 mt-1" id="statPendente">R$ 0,00</h3>
                    <p class="text-xs text-slate-400 mt-0.5" id="statProgressoPrc">0% Concluído</p>
                </div>
                <div class="p-3 bg-amber-50 rounded-lg text-amber-600">
                    <i class="fa-solid fa-clock text-2xl"></i>
                </div>
            </div>

            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Recebido em PIX</p>
                    <h3 class="text-2xl font-extrabold text-indigo-600 mt-1" id="statPix">R$ 0,00</h3>
                    <p class="text-xs text-slate-400 mt-0.5" id="statPixQtd">0 parcelas</p>
                </div>
                <div class="p-3 bg-indigo-50 rounded-lg text-indigo-600">
                    <i class="fa-solid fa-qrcode text-2xl"></i>
                </div>
            </div>

            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Recebido em Espécie</p>
                    <h3 class="text-2xl font-extrabold text-teal-600 mt-1" id="statEspecie">R$ 0,00</h3>
                    <p class="text-xs text-slate-400 mt-0.5" id="statEspecieQtd">0 parcelas</p>
                </div>
                <div class="p-3 bg-teal-50 rounded-lg text-teal-600">
                    <i class="fa-solid fa-money-bill-wave text-2xl"></i>
                </div>
            </div>
        </section>

        <!-- Barra de Ações Rápidas & Busca -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4 no-print">
            <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
                <button onclick="abrirModalEstudante()" class="flex-1 md:flex-none bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2.5 rounded-lg text-sm flex items-center justify-center transition shadow-sm">
                    <i class="fa-solid fa-user-plus mr-2"></i> Cadastrar Estudante +
                </button>
                <button onclick="abrirModalLote()" class="flex-1 md:flex-none bg-teal-600 hover:bg-teal-700 text-white font-semibold px-4 py-2.5 rounded-lg text-sm flex items-center justify-center transition shadow-sm">
                    <i class="fa-solid fa-users text-sm mr-2"></i> Cadastrar em Lote ++
                </button>
            </div>

            <div class="relative w-full md:w-72">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="inputBusca" placeholder="Buscar estudante..." onkeyup="filtrarEstudantes()" class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
        </div>

        <!-- Tabela Principal na Tela Interativa -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden no-print">
            <div class="table-container overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs min-w-[1200px]">
                    <thead>
                        <tr class="bg-slate-100 border-b border-slate-200 text-slate-700 font-semibold uppercase tracking-wider">
                            <th class="p-3 text-center w-12 min-w-[48px] max-w-[48px] sticky left-0 bg-slate-100 z-30 shadow-sm border-r border-slate-200">#</th>
                            <th class="p-3 min-w-[220px] sticky left-[48px] bg-slate-100 z-30 shadow-md border-r border-slate-300">Formando</th>
                            <!-- Colunas 1 até 10 -->
                            <template id="thParcelasTemplate">
                                <!-- Gerado dinamicamente via JS -->
                            </template>
                            <th class="p-3 text-center min-w-[100px] bg-slate-200">Total Pago</th>
                            <th class="p-3 text-center min-w-[100px] bg-slate-100">Status</th>
                            <th class="p-3 text-center min-w-[120px]">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="tabelaCorpo" class="divide-y divide-slate-200">
                        <!-- Linhas geradas via JavaScript -->
                    </tbody>
                    <tfoot>
                        <tr class="bg-slate-800 text-white font-bold">
                            <td class="p-3 text-center sticky left-0 bg-slate-800 z-30 shadow-md border-r border-slate-700" colspan="2">TOTAL GERAL DA TURMA</td>
                            <td id="footP1" class="p-2 text-center">R$ 0</td>
                            <td id="footP2" class="p-2 text-center">R$ 0</td>
                            <td id="footP3" class="p-2 text-center">R$ 0</td>
                            <td id="footP4" class="p-2 text-center">R$ 0</td>
                            <td id="footP5" class="p-2 text-center">R$ 0</td>
                            <td id="footP6" class="p-2 text-center">R$ 0</td>
                            <td id="footP7" class="p-2 text-center">R$ 0</td>
                            <td id="footP8" class="p-2 text-center">R$ 0</td>
                            <td id="footP9" class="p-2 text-center">R$ 0</td>
                            <td id="footP10" class="p-2 text-center">R$ 0</td>
                            <td id="footTotalGeral" class="p-3 text-center bg-emerald-700 text-white font-black text-sm">R$ 0,00</td>
                            <td class="p-3 text-center" colspan="2">
                                <span id="footEstudantesQtd" class="text-xs font-normal opacity-80">0 Formandos</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Estado Vazio -->
            <div id="estadoVazio" class="py-12 text-center text-slate-400 hidden">
                <i class="fa-solid fa-users-slash text-4xl mb-3 text-slate-300"></i>
                <p class="text-base font-medium">Nenhum formando cadastrado ainda.</p>
                <p class="text-xs mt-1">Clique em "Cadastrar Estudante +" ou "Cadastrar em Lote ++" para começar.</p>
            </div>
        </div>

        <!-- TEMPLATE EXCLUSIVO PARA O RELATÓRIO PDF (MODO RETRATO) -->
        <div id="areaRelatorioPDF" class="hidden">
            <div class="bg-white p-6 max-w-[210mm] mx-auto text-slate-900 font-sans border border-slate-200 shadow-sm">
                
                <!-- Cabeçalho do Relatório com Logo de Chapéu de Formatura -->
                <div class="flex items-center justify-between pb-4 border-b-2 border-indigo-900 mb-4">
                    <div class="flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-indigo-900 flex items-center justify-center text-white flex-shrink-0">
                            <i class="fa-solid fa-graduation-cap text-2xl"></i>
                        </div>
                        <div>
                            <h1 class="text-xl font-black text-indigo-950 uppercase tracking-tight">Formatura AFV 2026</h1>
                            <p class="text-xs font-bold text-slate-600">Colégio Estadual Pref. Anfilófio Fernandes Viana</p>
                            <p class="text-[10px] text-slate-500">Relatório Financeiro de Pagamento de Mensalidades</p>
                        </div>
                    </div>

                    <div class="text-right">
                        <span class="inline-block bg-indigo-100 text-indigo-900 font-extrabold px-2.5 py-1 rounded text-[10px] uppercase">Comissão de Formatura</span>
                        <p class="text-[10px] text-slate-500 mt-1" id="pdfDataGeracao">Gerado em: -</p>
                    </div>
                </div>

                <!-- Meta Informações em Grid Organizada -->
                <div class="grid grid-cols-3 gap-3 bg-slate-50 p-3 rounded-lg border border-slate-200 mb-4 text-xs">
                    <div>
                        <span class="block text-[9px] font-bold text-slate-400 uppercase">Turma / Curso</span>
                        <strong class="text-slate-800 font-bold" id="pdfTurmaInfo">-</strong>
                    </div>
                    <div>
                        <span class="block text-[9px] font-bold text-slate-400 uppercase">Líder Responsável</span>
                        <strong class="text-slate-800 font-bold" id="pdfLiderInfo">-</strong>
                    </div>
                    <div>
                        <span class="block text-[9px] font-bold text-slate-400 uppercase">Contato do Líder</span>
                        <strong class="text-slate-800 font-bold" id="pdfContatoLiderInfo">-</strong>
                    </div>
                </div>

                <!-- Resumo dos Valores -->
                <div class="grid grid-cols-4 gap-2 text-center mb-5">
                    <div class="p-2 bg-emerald-50 border border-emerald-200 rounded">
                        <span class="block text-[9px] font-bold text-emerald-800 uppercase">Total Arrecadado</span>
                        <strong class="text-sm font-extrabold text-emerald-700" id="pdfTotalArrecadado">R$ 0,00</strong>
                    </div>
                    <div class="p-2 bg-amber-50 border border-amber-200 rounded">
                        <span class="block text-[9px] font-bold text-amber-800 uppercase">Total Pendente</span>
                        <strong class="text-sm font-extrabold text-amber-700" id="pdfTotalPendente">R$ 0,00</strong>
                    </div>
                    <div class="p-2 bg-indigo-50 border border-indigo-200 rounded">
                        <span class="block text-[9px] font-bold text-indigo-800 uppercase">Total em PIX</span>
                        <strong class="text-sm font-extrabold text-indigo-700" id="pdfTotalPix">R$ 0,00</strong>
                    </div>
                    <div class="p-2 bg-teal-50 border border-teal-200 rounded">
                        <span class="block text-[9px] font-bold text-teal-800 uppercase">Total em Espécie</span>
                        <strong class="text-sm font-extrabold text-teal-700" id="pdfTotalEspecie">R$ 0,00</strong>
                    </div>
                </div>

                <!-- Tabela Minimalista para Modo Retrato -->
                <div class="mb-4">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-2 border-b pb-1">Detalhamento por Formando</h3>
                    <table class="pdf-table">
                        <thead>
                            <tr>
                                <th class="text-center w-8">#</th>
                                <th>Nome do Formando</th>
                                <th class="text-center">Parcelas Quitadas</th>
                                <th class="text-right">Total Pago</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody id="pdfTabelaCorpo">
                            <!-- Preenchido dinamicamente no JS -->
                        </tbody>
                        <tfoot>
                            <tr class="bg-slate-800 text-white font-bold">
                                <td colspan="3" class="p-2 text-right uppercase text-[10px]">Total Geral Arrecadado:</td>
                                <td id="pdfFootTotalGeral" class="p-2 text-right text-emerald-300 font-extrabold text-xs">R$ 0,00</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Rodapé Oficial do PDF -->
