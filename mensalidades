            for (let i = 1; i <= QTD_PARCELAS; i++) {
                csv += `P${i} Valor;P${i} Meio;`;
            }
            csv += 'Total Pago;Status\n';

            estado.estudantes.forEach(est => {
                let totalPago = 0;
                let linha = `"${est.nome}";"${est.telefone || ''}";"${est.ativo !== false ? 'SIM' : 'NÃO'}";`;

                for (let p = 1; p <= QTD_PARCELAS; p++) {
