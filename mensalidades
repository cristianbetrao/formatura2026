        // CORREÇÃO DA IMPORTAÇÃO CSV PARA LER CORRETAMENTE PARCELAS, TELEFONE E STATUS
        function processarImportacaoCSV(textoCSV) {
            const linhas = textoCSV.split(/\r\n|\n/).filter(line => line.trim() !== '');
            if (linhas.length < 2) {
                alert('O arquivo CSV selecionado está vazio ou não possui cabeçalhos.');
                return;
            }

            const separador = textoCSV.includes(';') ? ';' : ',';
            const novosEstudantes = [];

            for (let i = 1; i < linhas.length; i++) {
                const colunas = linhas[i].split(separador).map(col => col.replace(/^"|"$/g, '').trim());
                if (colunas.length < 2 || !colunas[0]) continue;

                const nome = colunas[0];
                const telefone = colunas[1] || '';
                
                // Verifica se a 3ª coluna indica status ativo/inativo ou se já pula direto para as parcelas
                let colIndex = 2;
                let ativo = true;
                if (colunas[2] && (colunas[2].toUpperCase() === 'SIM' || colunas[2].toUpperCase() === 'NÃO')) {
                    ativo = colunas[2].toUpperCase() === 'SIM';
                    colIndex = 3;
                }

                const parcelas = {};
                for (let p = 1; p <= QTD_PARCELAS; p++) {
                    const valNum = parseFloat(colunas[colIndex] ? colunas[colIndex].replace(',', '.') : 0) || 0;
                    const meio = colunas[colIndex + 1] ? colunas[colIndex + 1] : (valNum > 0 ? 'PIX' : 'Pendente');
                    parcelas[p] = { valor: valNum, meio: meio };
                    colIndex += 2;
                }

                novosEstudantes.push({
                    id: 'est_' + Date.now() + '_' + i + '_' + Math.random().toString(36).substring(2, 5),
                    nome: nome,
                    telefone: telefone,
                    obs: '',
                    ativo: ativo,
                    parcelas: parcelas
                });
            }

            if (novosEstudantes.length > 0) {
                estado.estudantes = novosEstudantes;
                ordenarFormandos();
                renderizar();
                mostrarToast(`${novosEstudantes.length} formandos importados via CSV com sucesso!`);
            } else {
                alert('Nenhum formando válido encontrado no CSV.');
            }
        }

