        // GERAR RELATÓRIO PDF EM MODO RETRATO A4 (FILTRANDO APENAS FORMANDOS ATIVOS)
        function gerarPDF() {
            ordenarFormandos();

            // Preenche dados do cabeçalho do PDF
            document.getElementById('pdfTurmaInfo').innerText = estado.cabecalho.turma || 'Formatura AFV 2026';
            document.getElementById('pdfLiderInfo').innerText = estado.cabecalho.lider || 'Não informado';
            document.getElementById('pdfContatoLiderInfo').innerText = estado.cabecalho.contatoLider || 'Não informado';
            
            const agora = new Date();
            document.getElementById('pdfDataGeracao').innerText = `Gerado em: ${agora.toLocaleDateString('pt-BR')} às ${agora.toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'})}`;

            // Constrói tabela minimalista e organizada para Portrait (SOMENTE FORMANDOS ATIVOS)
            const tbodyPDF = document.getElementById('pdfTabelaCorpo');
            tbodyPDF.innerHTML = '';

            let totalGeralAtivos = 0;
            let totalPixAtivos = 0;
            let totalEspecieAtivos = 0;
            let qtdAtivos = 0;

            const formandosAtivos = estado.estudantes.filter(est => est.ativo !== false);

            formandosAtivos.forEach((est, idx) => {
                qtdAtivos++;
                let totalEstudante = 0;
                let quitadasCount = 0;

                for (let p = 1; p <= QTD_PARCELAS; p++) {
                    const dadosP = est.parcelas[p] || { valor: 0, meio: 'Pendente' };
                    const val = parseFloat(dadosP.valor) || 0;
                    totalEstudante += val;
                    if (val >= VALOR_PARCELA) quitadasCount++;

                    if (val > 0) {
                        if (dadosP.meio === 'PIX') totalPixAtivos += val;
                        else if (dadosP.meio === 'Espécie') totalEspecieAtivos += val;
                        else if (dadosP.meio === 'Ambos') {
                            totalPixAtivos += val / 2;
                            totalEspecieAtivos += val / 2;
                        }
                    }
                }

                totalGeralAtivos += totalEstudante;

                const statusInfo = calcularStatusEstudante(est);

                const telExibicao = est.telefone ? est.telefone : null;
                const obsExibicao = est.obs ? est.obs : null;

                let infoAdicionalHTML = '';
                if (telExibicao || obsExibicao) {
                    let partes = [];
                    if (telExibicao) partes.push(`<strong>Tel:</strong> ${telExibicao}`);
                    if (obsExibicao) partes.push(`<strong>Obs:</strong> ${obsExibicao}`);
                    infoAdicionalHTML = `<div class="text-[9px] text-slate-500 font-normal mt-0.5">${partes.join(' • ')}</div>`;
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-center font-bold text-slate-400">${idx + 1}</td>
                    <td>
                        <div class="font-semibold text-slate-800">${est.nome}</div>
                        ${infoAdicionalHTML}
                    </td>
                    <td class="text-center font-bold text-indigo-900">${quitadasCount} / 10 parcelas</td>
                    <td class="text-right font-black text-slate-900">R$ ${totalEstudante.toFixed(2)}</td>
                    <td class="text-center">
                        <span class="inline-block text-[9px] font-extrabold px-2 py-0.5 rounded-full ${statusInfo.cor}">
                            ${statusInfo.texto}
                        </span>
                    </td>
                `;
                tbodyPDF.appendChild(tr);
            });

            const metaAtivos = qtdAtivos * VALOR_TOTAL_FORMANDO;
            const pendenteAtivos = metaAtivos - totalGeralAtivos;

            document.getElementById('pdfTotalArrecadado').innerText = `R$ ${totalGeralAtivos.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
            document.getElementById('pdfTotalPendente').innerText = `R$ ${pendenteAtivos.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
            document.getElementById('pdfTotalPix').innerText = `R$ ${totalPixAtivos.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
            document.getElementById('pdfTotalEspecie').innerText = `R$ ${totalEspecieAtivos.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;

            document.getElementById('pdfFootTotalGeral').innerText = `R$ ${totalGeralAtivos.toFixed(2)}`;

            // Exibe elemento temporariamente para captura do PDF
            const containerPDF = document.getElementById('areaRelatorioPDF');
            containerPDF.classList.remove('hidden');

            const element = containerPDF.firstElementChild;

            const opt = {
                margin:       [10, 10, 10, 10],
                filename:     `Relatorio_Formatura_AFV_2026_${(estado.cabecalho.turma || 'turma').replace(/[^a-z0-9]/gi, '_')}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            mostrarToast('Gerando relatório PDF (Somente formandos ativos)...');

            html2pdf().set(opt).from(element).save().then(() => {
                containerPDF.classList.add('hidden');
                mostrarToast('Relatório PDF baixado com sucesso!');
            }).catch(() => {
                containerPDF.classList.add('hidden');
            });
        }

        function mostrarToast(mensagem) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMensagem').innerText = mensagem;
            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
